{
  "name": "hax-ai-canvas",
  "version": "1.0.12",
  "description": "AI-powered Canvas course to HAX site builder — local web app for instructors",
  "scripts": {
    "build": "node scripts/build-hosted.cjs",
    "build:hosted": "node scripts/build-hosted.cjs",
    "test:upload": "node --test tests-js/*.test.cjs",
    "check:hosted": "python3 scripts/check_hosted.py"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "bin": {
    "hax-ai-canvas": "bin/index.js"
  },
  "files": [
    "bin/index.js",
    "python/*.py",
    "python/requirements.txt",
    "python/app/*.py",
    "python/app/static/*.css",
    "python/app/static/*.js",
    "python/app/templates/*.html",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "canvas",
    "hax",
    "lms",
    "ai",
    "course-builder",
    "education"
  ],
  "author": "djfusco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djfusco/hax-ai-canvas.git"
  }
}
